<?xml version="1.0"?>

<Node name="root" dt="0.01" gravity="0 -9.81 0">
    <!-- List of plugins needed to load all components used by this scene -->
    <Node name="plugins">
        <RequiredPlugin name="Sofa.Component.LinearSolver.Direct"/>
        <RequiredPlugin name="Sofa.Component.LinearSolver.Iterative"/>
        <RequiredPlugin name="Sofa.Component.StateContainer"/>
        <RequiredPlugin name="Sofa.Component.Mass"/>
        <RequiredPlugin name="Sofa.Component.IO.Mesh"/>
        <RequiredPlugin name="Sofa.Component.Topology.Container.Dynamic"/>
        <RequiredPlugin name="Sofa.Component.Topology.Container.Constant"/>
        <RequiredPlugin name="Sofa.Component.SolidMechanics.FEM.Elastic"/>
        <RequiredPlugin name="Sofa.Component.ODESolver.Backward"/>
        <RequiredPlugin name="Sofa.Component.Constraint.Projective"/>
        <RequiredPlugin name="Sofa.Component.Topology.Mapping"/>
        <RequiredPlugin name="Sofa.Component.MechanicalLoad"/>
        <RequiredPlugin name="Sofa.Component.Mapping.Linear"/>
		<RequiredPlugin name="Sofa.Component.Mapping.NonLinear"/>
		<RequiredPlugin name="Sofa.Component.Collision.Geometry"/>
		<RequiredPlugin name="Sofa.Component.Constraint.Lagrangian.Model"/>
		<RequiredPlugin name="Sofa.Component.Constraint.Lagrangian.Correction"/>
		<RequiredPlugin name="Sofa.Component.Constraint.Lagrangian.Solver"/>
		<RequiredPlugin name="Sofa.Component.Collision.Detection.Algorithm"/>
		<RequiredPlugin name="Sofa.Component.Collision.Detection.Intersection"/>
		<RequiredPlugin name="Sofa.Component.Collision.Response.Contact"/>
		<RequiredPlugin name="Sofa.Component.AnimationLoop"/>
    </Node>
	
	<FreeMotionAnimationLoop />
	<LCPConstraintSolver maxIt="1000" tolerance="1e-6" />
	<CollisionPipeline />
	<BruteForceDetection name="N2" />
	<NewProximityIntersection name="Proximity" alarmDistance="0.2" contactDistance="0.02" />
	<!--<LocalMinDistance alarmDistance="0.2" contactDistance="0.05" angleCone="0.01"/>-->
	<CollisionResponse response="FrictionContactConstraint" responseParams="mu=0.3"/>

    <!-- Rendering settings -->
    <!--<VisualStyle displayFlags="showVisual"/>-->

    <!-- Simulated deformable object -->
    <Node name="OBJ_Liver">
        <EulerImplicitSolver name="odeSolver"/>
        <CGLinearSolver name="linearSolver" iterations="25" threshold="1e-9" tolerance="1e-9"/>
        <MeshGmshLoader name="loader" filename="C:/Users/Pakito/Documents/Projets/AniSim/sofa/src/share/mesh/liver.msh"/>
        <MechanicalObject name="mstate" template="Vec3d" src="@loader" translation="0 12 0"/>
        <TetrahedronSetTopologyContainer name="topo" src="@loader"/>
        <TetrahedronSetTopologyModifier name="topoMod"/>
        <TetrahedronSetGeometryAlgorithms name="GeomAlgo" template="Vec3d"/>
        <UniformMass name="mass" totalMass="1"/>
        <TetrahedronFEMForceField name="forceField" template="Vec3d" listening="true" youngModulus="50.0" poissonRatio="0.3" method="large"/>
        <ConstantForceField name="InteractorForce" indices="100" totalForce="0 0 0"/>
        <!--<FixedProjectiveConstraint name="FixedConstraint" indices="1 3 50"/>-->
		<UncoupledConstraintCorrection />

        <Node name="LiverSurface">
            <TriangleSetTopologyContainer name="surfaceTopo"/>
            <TriangleSetTopologyModifier name="surfaceTopoMod"/>
            <TriangleSetGeometryAlgorithms name="surfaceGeom" template="Vec3d"/>
            <Tetra2TriangleTopologicalMapping input="@../topo" output="@surfaceTopo"/>
			<MechanicalObject name="surfaceMO" template="Vec3d" />
			<BarycentricMapping input="@../mstate" output="@surfaceMO"/>
        </Node>
		
		<Node name="LiverCollision">
			<MeshOBJLoader name="collisionLoader" filename="C:/Users/Pakito/Documents/Projets/AniSim/sofa/src/share/mesh/liver.obj" handleSeams="true"/>
			<TriangleSetTopologyContainer name="collisionTopo" src="@collisionLoader"/>
            <TriangleSetTopologyModifier name="collisionTopoMod"/>
            <TriangleSetGeometryAlgorithms name="collisionGeom" template="Vec3d"/>

			<MechanicalObject name="collisionMO" template="Vec3d" src="@collisionLoader"  translation="@../mstate.translation"/>
			<BarycentricMapping input="@../mstate" output="@collisionMO"/>
			<TriangleCollisionModel/>
		</Node>

        <Node name="LiverVisual">
            <MeshOBJLoader name="visualMeshLoader" filename="C:/Users/Pakito/Documents/Projets/AniSim/sofa/src/share/mesh/liver.obj" handleSeams="true"/>
            <TriangleSetTopologyContainer name="visualTopo" src="@visualMeshLoader" />
            <MechanicalObject name="visualDofs" template="Vec3d" src="@visualMeshLoader" translation="@../mstate.translation"/>
            <BarycentricMapping input="@../mstate" output="@visualDofs"/>
        </Node>
    </Node>
	<Node name="TOOL_Primary">
		<MechanicalObject name="toolDOFs" template="Rigid3d" position="0 20 0 0 0 0 1"/>
		<Node name="PrimaryToolCollision">
			<MechanicalObject name="collisionDOFs" template="Rigid3d"/>
			<RigidMapping input="@../toolDOFs" output="@collisionDOFs"/>
			<SphereCollisionModel radius="0.5"/>
		</Node>
	</Node>
	<Node name="OBJ_Tray">
		<MechanicalObject name="TrayDofs" template="Vec3d" src="@TrayLoader" position="-21.5 -1 -16.5 21.5 -1 -16.5 21.5 -1 16.5 -21.5 -1 16.5" scale3d="0.4 0.4 0.4" />
		<Node name="TrayCollision">
			<MechanicalObject name="TrayCollisionDofs" template="Vec3d" position="@../TrayDofs.position"/>
			<TriangleSetTopologyContainer name="collisionTopo" triangles="0 1 2  0 2 3" />
			<TriangleCollisionModel simulated="0" moving="0"/>
		</Node>
	</Node>
</Node>